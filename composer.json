{
  "name": "fatrbaby/knob",
  "type": "library",
  "license": "Apache-2.0",
  "autoload": {
    "psr-4": {
      "Knob\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests"
    }
  },
  "authors": [
    {
      "name": "fatrbaby",
      "email": "mrfatr@gmail.com"
    }
  ],
  "require": {
    "php": ">= 8.2",
    "ext-pdo": "*"
  },
  "require-dev": {
    "pestphp/pest": "^4.3",
    "laravel/pint": "*"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
