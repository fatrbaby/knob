# Copy this file to .env and fill in the databases you want to smoke test.
# Empty DSNs are skipped.

KNOB_MYSQL_DSN=mysql:host=127.0.0.1;port=3306;dbname=knob_test
KNOB_MYSQL_USER=root
KNOB_MYSQL_PASSWORD=

KNOB_PGSQL_DSN=pgsql:host=127.0.0.1;port=5432;dbname=knob_test
KNOB_PGSQL_USER=postgre
KNOB_PGSQL_PASSWORD=

KNOB_SQLSRV_DSN=sqlsrv:Server=127.0.0.1,1433;Database=knob_test
KNOB_SQLSRV_USER=sa
KNOB_SQLSRV_PASSWORD=your-password
